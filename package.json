{
  "name": "@maocili/vibe-init",
  "version": "0.3.0",
  "packageManager": "pnpm@11.22.0",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/maocili/vibe-init.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "description": "Project initializer that materializes versioned rules, notes, skills, and tooling.",
  "type": "module",
  "engines": { "node": ">=18" },
  "files": [
    "bin/",
    "lib/",
    "packages/"
  ],
  "scripts": {
    "test": "node --test",
    "package:check": "pnpm test && pnpm pack --dry-run",
    "package:build": "pnpm run package:check && pnpm pack --pack-destination artifacts"
  },
  "bin": { "vibe-init": "./bin/vibe-init.mjs" }
}
